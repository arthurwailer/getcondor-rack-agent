# Config especifica de este rack/avion -- copiar a .env y completar
DRONE_ID=OSCAR01
GETCONDOR_API_URL=https://getcondor.win/api
GETCONDOR_API_KEY=

# Carpeta local (en el host del rack) donde ya llegan fotos/videos/ortofotos
MEDIA_WATCH_DIR=/media/shamrock/uploads

# Telemetria (opcional, si este agente tambien reenvia telemetria)
TELEMETRY_ENABLED=false
